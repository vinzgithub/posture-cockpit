#
# Optional settings of Posture Cockpit with Docker Compose. Copy this file to .env, next to
# compose.yaml, keep only the lines you need, then: docker compose up -d
# Réglages facultatifs. Copiez ce fichier en .env, à côté de compose.yaml, gardez seulement les
# lignes utiles, puis : docker compose up -d
#
#   curl -fsSL https://raw.githubusercontent.com/vinzgithub/posture-cockpit/v0.4.1/.env.example -o .env
#
# A line starting with # is ignored. Une ligne commençant par # est ignorée.

# ---- Address and time / Adresse et heure --------------------------------------------------
# Port of the server (default 8080). Port du serveur (8080 par défaut).
#POSTURE_COCKPIT_PORT=8081
# Listening address of the server. Default: every interface. 127.0.0.1 behind a reverse proxy
# on the same server. Adresse d'écoute ; par défaut toutes. 127.0.0.1 derrière un proxy local.
#POSTURE_COCKPIT_BIND=127.0.0.1
# Time zone of pages and PDF reports (stored times and the API stay in UTC).
# Fuseau horaire des pages et des PDF (les heures stockées et l'API restent en UTC).
#TZ=Europe/Paris

# ---- Behind an HTTPS reverse proxy / Derrière un proxy inverse HTTPS ----------------------
# Session cookie sent over HTTPS only, and HSTS. Cookie de session en HTTPS seulement, et HSTS.
#POSTURE_COCKPIT_COOKIE_SECURE=true
# Address of the proxy, whose X-Forwarded-* headers are trusted (several: comma-separated).
# Adresse du proxy dont les en-têtes X-Forwarded-* sont crus (plusieurs : séparées par des virgules).
#FORWARDED_ALLOW_IPS=172.18.0.2
# Pages allowed to show Posture Cockpit in a frame (Home Assistant...).
# Pages autorisées à afficher Posture Cockpit dans un cadre (Home Assistant...).
#POSTURE_COCKPIT_FRAME_ANCESTORS=https://ha.example.org

# ---- Scans / Analyses -----------------------------------------------------------------------
# DNS resolvers instead of those of the system. Résolveurs DNS à la place de ceux du système.
#POSTURE_COCKPIT_NAMESERVERS=9.9.9.9,1.1.1.1
# Internal perimeters (scans of private networks, administrators only).
# Périmètres internes (analyses de réseaux privés, administrateurs seulement).
#POSTURE_COCKPIT_INTERNAL_SCANS=true
#POSTURE_COCKPIT_MAX_CONCURRENT_SCANS=4
#POSTURE_COCKPIT_SCANS_PER_HOUR=30
# Scheduler ON by default from v0.5.0; explicitly set OFF for the first upgrade.
# Ordonnanceur ON par défaut en v0.5.0 ; fixer OFF avant la première migration.
# Uncomment this line before upgrading, enable only after schedule and quota review.
# Décommenter avant migration, puis n'activer qu'après contrôle des horaires et quotas.
#POSTURE_COCKPIT_SCHEDULER=off
# Extra DKIM selectors to try, comma-separated. Sélecteurs DKIM supplémentaires.
#POSTURE_COCKPIT_DKIM_SELECTORS=mail,s1

# ---- Interface ------------------------------------------------------------------------------
# Language of the sign-in pages: fr or en. Langue des pages de connexion : fr ou en.
#POSTURE_COCKPIT_DEFAULT_LOCALE=fr
# Code of the first account, instead of the random one written to the log at each start.
# At least 12 letters or digits. Code du premier compte, au lieu du code aléatoire du journal.
#POSTURE_COCKPIT_SETUP_CODE=choose-a-long-code

# ---- A second instance on the same server / Une seconde instance sur le même serveur ------
# Project, container, port and cookie of its own: its volume is then separate.
# Projet, conteneur, port et cookie propres : son volume est alors distinct.
#COMPOSE_PROJECT_NAME=posture-cockpit-test
#POSTURE_COCKPIT_CONTAINER=posture-cockpit-test
#POSTURE_COCKPIT_PORT=8089
#POSTURE_COCKPIT_SESSION_COOKIE=posture_cockpit_test
# Image to run instead of the version of compose.yaml (an image built locally, for a test).
# Image à utiliser à la place de la version de compose.yaml (image construite localement, pour un test).
#POSTURE_COCKPIT_IMAGE=posture-cockpit:local
